# ── Verba AI · voice agents for Digital Suvidha (Sahayak AI) · API keys ──────
# Copy this file to ".env" and fill in your keys. Never commit the real .env.

# Google Gemini — the LLM brain. REQUIRED (the agent can't reason without it).
# Get one free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extra Gemini keys — requests are spread round-robin across ALL keys (and rotate
# on a 429 quota), so the free-tier rate limit is effectively multiplied by how many you add.
# IMPORTANT: for this to actually RAISE your limit, each key must be from a DIFFERENT
# Google project/account — keys created in the same project share the same quota.
# Alternative: set GEMINI_API_KEYS as one comma-separated list instead of numbered vars.
GEMINI_API_KEYS=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=
GEMINI_API_KEY_12=
# …slots up to GEMINI_API_KEY_100 are read automatically — just add more numbered lines.

# Optional: split the key pool across two model tiers (some newer-account keys 404 on an
# older pinned GEMINI_MODEL id). The first GEMINI_PRIMARY_KEY_COUNT keys (in .env order) use
# GEMINI_MODEL; every key after that uses GEMINI_MODEL_FALLBACK. Leave both unset and every
# key just uses GEMINI_MODEL.
GEMINI_MODEL_FALLBACK=
GEMINI_PRIMARY_KEY_COUNT=

# Sarvam AI — English/Hindi speech-to-text (Saaras v3, code-mix). RECOMMENDED.
# Free credits at: https://dashboard.sarvam.ai  (Settings → API Keys)
# If blank, the page falls back to the browser's built-in speech recognition (Chrome/Edge).
SARVAM_API_KEY=

# ElevenLabs — the voice you hear (English + Hindi).
# Get the API key at: elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=
# Optional extra ElevenLabs keys — auto-rotates when one runs out of credits. Each key is a
# separate ElevenLabs account, and the SAME voice (ELEVENLABS_VOICE_ID) must be added to that
# account's voice library too, or its requests 404. Or set ELEVENLABS_API_KEYS as one
# comma-separated list instead of the numbered vars.
ELEVENLABS_API_KEYS=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=
ELEVENLABS_VOICE_ID=
# Per-language voice overrides; each falls back to ELEVENLABS_VOICE_ID above if unset.
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=
# This clone only uses English/Hindi — left here only because the shared engine reads it;
# harmless to leave blank.
ELEVENLABS_VOICE_ID_TE=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_MODEL_ID_ENHI=eleven_multilingual_v2

# ── Knobs (sensible defaults; usually leave as-is) ───────────────────────────
# Which voice speaks first: elevenlabs | sarvam | none
TTS_PROVIDER=elevenlabs
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
# This clone never selects Telugu, so this knob is inert here — left for engine parity.
TELUGU_TTS=sarvam
# The brain. Default "gemini-flash-latest" (NOT the -lite tier) — smarter, more mature, less
# bot-like. "-latest" alias on purpose: pinned ids get retired for newer Google accounts, and
# the rotation pool mixes account ages, so the alias is the only id valid on every key.
GEMINI_MODEL=gemini-flash-latest
# How much the model "thinks" before replying (tokens). Higher = more considered/human, a bit
# slower. 0 = off (instant, more bot-like). 512 is a good balance.
GEMINI_THINKING_BUDGET=512

# Access gate — password to open the pages (defaults to sahayak@ai if unset)
ADMIN_PASSWORD=sahayak@ai
